    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bcrypt": "^6.0.0",
